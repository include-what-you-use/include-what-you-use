// Uses IndirectClass without #including indirect.h: implementation_file.h
// does.  The #include of implementation_file.h is redundant, since that
// file #includes this one: it is kept, but not required.  The macros of
// -i1.h and -i2.h are only used here, so their #includes belong here.  The
// macro of -i2.h is only used in a #define.

#include "implementation_file.h"
#include "tests/cxx/implementation_file-i1.h"
#include "tests/cxx/implementation_file-i2.h"

#define IMPL_FILE_TWO (2 * IMPL_FILE_ONE)

inline void ImplFileClass::InlineMethod() {
  IndirectClass local;
  local.Method();
}

template <typename T>
void ImplFileClass::TemplateMethod(T t) {
  IndirectClass local;
  local.a = t;
}

class ImplFileClass::Nested {
  IndirectClass nested_member;
};

inline int ImplFileFunction(int i) {
  IndirectClass local;
  return local.a + IMPL_FILE_TWICE(i);
}

template <typename T>
T ImplFileTemplate(T t) {
  IndirectClass local;
  return local.a + t;
}

#include "tests/cxx/implementation_file-detail.icc"

/**** IWYU_SUMMARY

(tests/cxx/implementation_file-impl.icc has correct #includes/fwd-decls)

