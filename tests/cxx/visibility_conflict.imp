  { "include": ["\"tests/cxx/visibility_conflict-i1.h\"", "private", "\"tests/cxx/visibility_conflict-d1.h\"", "public"] },
  { "include": ["\"tests/cxx/visibility_conflict-d1.h\"", "private", "\"tests/cxx/visibility_conflict-d1.h\"", "public"] }
]
