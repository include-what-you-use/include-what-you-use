// #included by implementation_file-impl.icc, but defines what
// implementation_file.h declares.  Uses IndirectClass without #including
// indirect.h, and a macro of -i1.h without #including it: the files that
// #include this one do.

inline void ImplFileClass::DetailMethod() {
  IndirectClass local;
  local.a = IMPL_FILE_TWICE(1);
}

