// Uses IndirectClass, provided by associated_icc_default.h, without
// #including "tests/cxx/indirect.h" itself and without a mapping file
// declaring the relation.

inline void DefaultIccClass::InlinedMethod() {
  IndirectClass local;
  local.Method();
}

